<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#482050"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <!-- Top Background Area -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:layout_marginTop="100dp"
        >

        <!--        <Button-->
        <!--            android:id="@+id/testcrash"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="Test Crash" />-->
        <TextView
            android:id="@+id/t1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textStyle="bold"/>


        <TextView
            android:id="@+id/header_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Hi, Welcome back, you've been missed"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:textSize="15sp"/>


    </LinearLayout>



    <!-- Card -->

    <com.google.android.material.card.MaterialCardView

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"

        android:layout_marginTop="-50dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="10dp"
        app:strokeWidth="1dp"
        >


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">


            <!-- Email -->

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone No / Email"

                app:boxBackgroundMode="none"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_useremail"
                    android:layout_width="match_parent"
                    android:background="@drawable/text_field"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>



            <!-- Password -->

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"

                android:hint="Password"

                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_password"
                    android:layout_width="match_parent"
                    android:background="@drawable/text_field"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"/>

            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_user"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="Submit"
                android:textColor="@color/white"
                app:cornerRadius="30dp"
                app:backgroundTint="#482050"/>



            <TextView
                android:id="@+id/forgot_pwd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="15dp"
                android:text="Forgot Password?"
                android:textColor="#1976D2"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">
                <View android:id="@+id/view1"
                    android:layout_width="90dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#38D4F0"/>
                <TextView android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/view1"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="15dp"
                    android:text="Or sign up with"/>
                <View android:id="@+id/view2"
                    android:layout_width="90dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_toRightOf="@id/tv1"
                    android:background="#38D4F0"/>


            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:id="@+id/signIn"
                    android:gravity="center"
                    android:text="Don't have a account?SIGN UP"/>

                <ImageView android:id="@+id/google_login"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/google"
                    android:contentDescription="Google Login"/>


            </LinearLayout>

        </LinearLayout>




    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>